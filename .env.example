# === 应用 ===
APP_NAME=FSAgent
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# === 服务端口 ===
API_HOST=0.0.0.0
API_PORT=8000

# === PostgreSQL ===
DATABASE_URL=postgresql+asyncpg://fsagent:fsagent@localhost:5432/fsagent
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# === Redis (工作记忆 + 缓存) ===
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# === Redis Cluster (Wiki Cache 独立集群) ===
REDIS_CLUSTER_NODES=redis-cluster-0:6379,redis-cluster-1:6379,redis-cluster-2:6379
REDIS_CLUSTER_PASSWORD=

# === Milvus (语义记忆) ===
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=fsagent_semantic_memory

# === LLM ===
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# === Embedding ===
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-your-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSION=1536

# === 飞书 ===
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_VERIFICATION_TOKEN=xxx
FEISHU_ENCRYPT_KEY=xxx
FEISHU_BOT_NAME=FSAgent

# === 企业微信 ===
WECHAT_CORP_ID=xxx
WECHAT_CORP_SECRET=xxx
WECHAT_AGENT_ID=xxx
WECHAT_TOKEN=xxx
WECHAT_ENCODING_AES_KEY=xxx

# === JWT / Auth ===
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
API_KEY_HEADER=X-API-Key

# === 限流 ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_WEBHOOK=120/minute

# === Wiki Cache ===
WIKI_CACHE_TTL=3600
WIKI_REFRESH_INTERVAL=300

# === 会话 ===
SESSION_TTL_SECONDS=1800
SESSION_MAX_MESSAGES=50
